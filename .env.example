# ── App (Expo) — copy to .env, never commit .env ───────────────────────────
# EXPO_PUBLIC_* values are bundled into the app binary, so only put
# public-by-design values here (project URL, publishable/anon key, OAuth client IDs).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_OURA_CLIENT_ID=your-oura-client-id
# Not used yet (subscription is stubbed)
EXPO_PUBLIC_REVENUECAT_API_KEY=
# WHOOP integration is partial; client secrets must NOT ship in the app.
WHOOP_CLIENT_ID=

# ── Supabase Edge Function secrets — set with `supabase secrets set`, never here ──
# ANTHROPIC_API_KEY=
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY=
# DASHBOARD_SECRET=
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided by Supabase)
