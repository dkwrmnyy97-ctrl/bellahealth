{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_OURA_CLIENT_ID": "your-oura-client-id"
      },
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_OURA_CLIENT_ID": "your-oura-client-id"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "your-app-store-connect-app-id"
      }
    }
  }
}
